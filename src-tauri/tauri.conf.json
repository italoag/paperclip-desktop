{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperclip Desktop",
  "identifier": "com.paperclipai.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aronprins/paperclip-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQkY4RjE4OEZFNUFENEUKUldST3JlV1BHSSsvem1uQWx6RloxTll5ak1sdmVRbHlLclFheWZLclg2Y25BNUhYUUtEblFoQUUK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Aron Prins",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "../build/entitlements.mac.plist"
    },
    "createUpdaterArtifacts": true
  }
}
